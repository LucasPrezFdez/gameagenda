{
  "name": "gameagenda",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Agenda personal de videojuegos: apunta en segundos los juegos que quieres jugar.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.21.0"
  },
  "workspaces": [
    "apps/web",
    "packages/core",
    "pipeline"
  ],
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "npm run dev -w @gameagenda/web",
    "build": "npm run build -w @gameagenda/web",
    "preview": "npm run preview -w @gameagenda/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/test && tsc -p apps/web && tsc -p apps/web/tsconfig.sw.json && tsc -p apps/web/tsconfig.worker.json && tsc -p apps/web/tsconfig.node.json && tsc -p apps/web/tsconfig.bench.json && tsc -p scripts && tsc -p pipeline",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "size": "node scripts/size-gate.ts",
    "e2e": "npm run e2e -w @gameagenda/web",
    "perf": "npm run perf -w @gameagenda/web",
    "catalog:frozen": "node scripts/catalog-from-frozen.ts",
    "catalog:build": "node --env-file-if-exists=.env.local pipeline/build.ts",
    "catalog:stage": "node --env-file-if-exists=.env.local scripts/catalog-stage.ts",
    "catalog:publish": "node scripts/catalog-publish.ts",
    "fixtures:record": "node --env-file-if-exists=.env.local pipeline/record-fixtures.ts",
    "fixtures:freeze": "node pipeline/freeze-fixtures.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  }
}
