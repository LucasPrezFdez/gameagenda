// Worker `ga-web` (§5.2 y §14 de prototipe.md): solo *assets* estáticos del *build* de producción
// (`npm run build`), con el *fallback* de la SPA para los enlaces profundos (`/juego/steam:730`).
// Las cabeceras van en `public/_headers`, que Vite copia a `dist/`. Desde M4, un *script* Hono
// solo en `/api/*`. Lo despliega `.github/workflows/deploy-web.yml`; en local:
// `npx wrangler dev -c apps/web/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ga-web",
  // La más reciente que admite el `workerd` de `wrangler` 4.155.0 (1.20261023.1).
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
