{
  "name": "@gameagenda/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "La app: SPA de React + Vite, PWA local-first.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.sw.json && vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "npm run build:e2e && npm run serve:e2e",
    "serve:e2e": "vite preview --mode e2e",
    "typecheck": "tsc -p . && tsc -p tsconfig.sw.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.bench.json",
    "e2e": "playwright test",
    "perf": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@gameagenda/core": "0.0.0",
    "@tanstack/react-virtual": "3.14.24",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1"
  }
}
